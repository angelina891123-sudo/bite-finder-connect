# Copy this file to .env and fill in the values from your own Supabase project
# (Supabase Dashboard → Project Settings → General / API Keys).
# .env is git-ignored — never commit real values, especially the service role key.

# Project Settings → General → Reference ID
SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PROJECT_ID=""

# Project Settings → Data API → Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=""
VITE_SUPABASE_URL=""

# Project Settings → API Keys → Publishable key (sb_publishable_... or legacy anon eyJ...).
# Safe to expose to the browser; access is restricted by RLS policies.
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Project Settings → API Keys → Secret key (sb_secret_... or legacy service_role eyJ...).
# SERVER-ONLY: bypasses all RLS. Used by src/integrations/supabase/client.server.ts.
# Never prefix this with VITE_ — that would ship it to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=""
